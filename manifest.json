{
  "manifest_version": 3,
  "name": "Termofy",
  "short_name": "Termofy",
  "version": "2.0.3",
  "description": "Alertas de atendimentos e mensagens de clientes, agrupamento por etiqueta e destaques na fila do Opa! Suite.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "tabs",
    "offscreen",
    "scripting",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Termofy"
  },
  "content_scripts": [
    {
      "matches": [
        "https://suporte.ixcsoft.com.br/*",
        "https://opasuiteapi.ixcsoft.com.br/*"
      ],
      "js": [
        "content/queue-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://suporte.ixcsoft.com.br/*",
        "https://opasuiteapi.ixcsoft.com.br/*"
      ],
      "js": [
        "content/tag-settings.js",
        "content/groups.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://suporte.ixcsoft.com.br/*",
        "https://opasuiteapi.ixcsoft.com.br/*"
      ],
      "js": [
        "termostato/src/config.js",
        "termostato/src/storage.js",
        "termostato/src/opa-dom.js",
        "termostato/src/pendencia.js",
        "termostato/src/humor-regras.js",
        "termostato/src/humor.js",
        "termostato/src/termometro.js",
        "termostato/src/lista.js",
        "integrations/termostato.js",
        "termostato/src/main.js"
      ],
      "css": [
        "termostato/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
