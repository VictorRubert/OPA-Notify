{
  "manifest_version": 3,
  "name": "Termostato – Humor do cliente e pendência externa no Opa",
  "description": "Mede o humor do cliente nas últimas mensagens e marca a pendência externa automaticamente no Opa.",
  "version": "2.22.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://suporte.ixcsoft.com.br/*"
      ],
      "js": [
        "src/config.js",
        "src/storage.js",
        "src/opa-dom.js",
        "src/pendencia.js",
        "src/humor-regras.js",
        "src/humor.js",
        "src/termometro.js",
        "src/lista.js",
        "src/main.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "short_name": "Termostato"
}